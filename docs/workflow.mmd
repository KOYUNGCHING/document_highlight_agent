---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	begin(begin)
	summarize_memory(summarize_memory)
	planner(planner)
	collect(collect)
	answer(answer)
	document_summary(document_summary)
	review(review)
	revise(revise)
	finalize(finalize)
	__end__([<p>__end__</p>]):::last
	__start__ --> begin;
	answer --> review;
	begin -.-> planner;
	begin -.-> summarize_memory;
	collect -.-> answer;
	collect -.-> document_summary;
	document_summary --> review;
	planner -.-> collect;
	planner -.-> finalize;
	review -.-> finalize;
	review -.-> revise;
	revise --> review;
	summarize_memory --> planner;
	finalize --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
